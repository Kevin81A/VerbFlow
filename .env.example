# ========================================================
# VerbFlow - Configuration Template (.env.example)
# Variables de Entorno del Proyecto (Supabase & App Engine)
# ========================================================

# URL pública de tu proyecto Supabase (Ej: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública anónima (segura para el navegador con RLS activado)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Configuración de Entorno
NODE_ENV=production
APP_BASE_URL=https://kevin81a.github.io/VerbFlow/
